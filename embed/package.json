{
  "name": "oforms-embed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone client bundle of the oforms main page (templates catalog) for ONLYOFFICE Desktop. Reuses the real components from ../src.",
  "scripts": {
    "install:all": "npm install --prefix .. && npm install",
    "install:all:ci": "npm ci --prefix .. && npm ci",
    "generate": "node scripts/generate-data.mjs",
    "build": "node scripts/generate-data.mjs && vite build && node scripts/postbuild.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "check:measures": "node scripts/check-measures.mjs",
    "check:typography": "node scripts/check-typography.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "oforms.onlyoffice.com": "file:.."
  }
}
