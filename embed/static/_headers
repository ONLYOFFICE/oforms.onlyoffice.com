# Cloudflare Pages headers. Copied verbatim into the build output.
#
# Asset filenames are content-hashed by Vite, so they can be cached forever;
# index.html must not be, or a deploy would not reach anyone.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Requested with the ?v= stamp baked into the bundle, so the stamp is the cache
# key and the path itself never needs revalidating. CORS stays open because the
# catalogs used to be fetched cross-origin and a host may still point at them.
/embed-data/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
