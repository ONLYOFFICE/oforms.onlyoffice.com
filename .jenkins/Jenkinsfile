println("Branch name: ${BRANCH_NAME}")

switch(BRANCH_NAME) {
  case "develop":
    aws_region="us-east-1"
    awslogs_region = "us-east-1"
    awslogs_group = "/site/www"
    awslogs_stream = "templates.teamlab.info"
    awslogs_stream_errors = "templates.teamlab.info-errors"
    awslogs_enabled = "true"
    deploy_expose_port = "40002"
    deploy_app_name = "templates.teamlab.info"
    region="info"
    cloud_front_distribution_id="E3OQ4LKWZZXBRX"
    cdn77_distribution_id="1913924170"
    site_url="https://templates.teamlab.info"   
    public_static_url="https://static-oforms.teamlab.info"
    next_public_main_site_base_domain="https://www.teamlab.info"
    break
  case "master":
    aws_region="us-west-2"
    awslogs_region = "us-west-2"
    awslogs_group = "/site/www"
    awslogs_stream = "templates-cms.onlyoffice.com"
    awslogs_stream_errors = "templates-cms.onlyoffice.com-errors"
    awslogs_enabled = "true"
    deploy_expose_port = "40002"
    deploy_app_name = "templates.onlyoffice.com"
    region="com"
    MONITOR_ID = '58439000014815195'
    cloud_front_distribution_id="E18Y5OI4JS5NAJ"
    cdn77_distribution_id="1919473175"
    site_url="https://templates.onlyoffice.com"    
    public_static_url="https://static-oforms.onlyoffice.com"
    next_public_main_site_base_domain="https://www.onlyoffice.com"
    break
  default:
    println("Branch: ${BRANCH_NAME} do not for deploy.")
    break
}

pipeline {
  agent { label 'ubuntu' }
  triggers {
    githubPush()
  }
  options {
    disableConcurrentBuilds()
    buildDiscarder (logRotator(numToKeepStr: '5', artifactNumToKeepStr: '5'))
  }
  stages {
    stage('stop_monitor') {
      when { branch 'master' }
      steps {
        build job: 'monitor.24x7.start.stop', 
          parameters: [string(name: 'monitor_id', value: "${MONITOR_ID}"), 
          string(name: 'action', value: 'suspend')]
      }    
    }
    
    stage('deploy') {
      when { 
        anyOf { branch 'develop'; 
                branch 'master' }
      }
      environment {
        awslogs_region = "${awslogs_region}"
        awslogs_group = "${awslogs_group}"
        awslogs_stream = "${awslogs_stream}"
        awslogs_stream_errors = "${awslogs_stream_errors}"
        awslogs_enabled = "${awslogs_enabled}"
        deploy_expose_port = "${deploy_expose_port}"
        deploy_app_name = "${deploy_app_name}"
        aws_region = "${aws_region}"
        region = "${region}"        
        site_url="${site_url}"
        next_public_main_site_base_domain="${next_public_main_site_base_domain}"
        public_static_url="${public_static_url}"
      }
      steps { 
        withCredentials([usernamePassword(credentialsId: 'NEXT_PUBLIC_EDITOR_CREDS',
                passwordVariable: 'NEXT_PUBLIC_FILES_DOCSERVICE_SECRET',
                usernameVariable: 'NEXT_PUBLIC_EDITOR_API_URL'),
                usernamePassword(credentialsId: 'NEXT_PUBLIC_EDITOR_CREDS_TEST',
                passwordVariable: 'NEXT_PUBLIC_FILES_DOCSERVICE_SECRET_TEST',
                usernameVariable: 'NEXT_PUBLIC_EDITOR_API_URL_TEST'),
                string(credentialsId: 'templates_redesign_revalidate_authorization_token', variable: 'REVALIDATE_AUTHORIZATION_TOKEN_TEST')]) {

          sh '''
            if [ "$BRANCH_NAME" = "develop" ]; then
              NEXT_PUBLIC_EDITOR_API_URL=$NEXT_PUBLIC_EDITOR_API_URL_TEST
              NEXT_PUBLIC_FILES_DOCSERVICE_SECRET=$NEXT_PUBLIC_FILES_DOCSERVICE_SECRET_TEST
              REVALIDATE_AUTHORIZATION_TOKEN=$REVALIDATE_AUTHORIZATION_TOKEN_TEST 
            fi

            if [ "$BRANCH_NAME" = "master" ]; then
              REVALIDATE_AUTHORIZATION_TOKEN=$REVALIDATE_AUTHORIZATION_TOKEN_TEST 
            fi

            sed -i "s^var_notification_app_name^$site_url^" .jenkins/build.sh
            sed -i "s^var_awslogs_region^$awslogs_region^" .jenkins/build.sh
            sed -i "s^var_awslogs_group^$awslogs_group^" .jenkins/build.sh
            sed -i "s^var_awslogs_stream^$awslogs_stream^" .jenkins/build.sh
            sed -i "s^var_expose_port^$deploy_expose_port^" .jenkins/build.sh
            sed -i "s^var_app_name^$deploy_app_name^" .jenkins/build.sh
            cp .jenkins/build.sh ".jenkins/${deploy_app_name}_build.sh"

            sed -i "s^config_docEditorUrl^$NEXT_PUBLIC_EDITOR_API_URL^" src/config/config.json

            sed -i "s^var_next_public_site_url^$site_url^" .env.local
            sed -i "s^var_next_public_static_url^$public_static_url^" .env.local
            sed -i "s^var_files_docservice_secret^$NEXT_PUBLIC_FILES_DOCSERVICE_SECRET^" .env.local
            sed -i "s^var_revalidate_authorization_token^$REVALIDATE_AUTHORIZATION_TOKEN^" .env.local

            sed -i "s^var_next_public_main_site_base_domain^$next_public_main_site_base_domain^" .env.local
            
            tar -czpf ".jenkins/${deploy_app_name}.tar.gz" \
              --exclude ".git" \
              --exclude ".gitignore" \
              --exclude ".jenkins" \
              --exclude "README.md" .
            
            echo "Deploy from ${BRANCH_NAME} is starting."
          '''
        }
        
        sshPublisher(failOnError: true, publishers: [sshPublisherDesc(configName: "sites2026@${region}", 
          transfers: [sshTransfer(cleanRemote: false, 
            excludes: '', 
            execCommand: """
              sudo bash "/home/ubuntu/deploy/.jenkins/${env.deploy_app_name}_build.sh" \
                  2>&1 | tee -a "/home/ubuntu/deploy/${env.deploy_app_name}_deploy.log"
            """, 
            execTimeout: 1200000, 
            flatten: false, 
            makeEmptyDirs: false, 
            noDefaultExcludes: false, 
            patternSeparator: '[, ]+', 
            remoteDirectory: '', 
            remoteDirectorySDF: false, 
            removePrefix: '', 
            sourceFiles: ".jenkins/${deploy_app_name}.tar.gz,.jenkins/${deploy_app_name}_build.sh")], 
          usePromotionTimestamp: false, 
          useWorkspaceInPromotion: false, 
          verbose: false)])
      }
    }
    stage('invalidation') {
      when { 
        anyOf { branch 'develop'; 
                branch 'master' }
      }
      environment {
        aws_region = "${aws_region}"
        cloud_front_distribution_id = "${cloud_front_distribution_id}"
      }
      steps {
        withCredentials([
                usernamePassword(credentialsId: 'aws_build_robot', 
                passwordVariable: 'secret_key', 
                usernameVariable: 'access_key')]) {
          sh '''
            export AWS_ACCESS_KEY_ID="$access_key"
            export AWS_SECRET_ACCESS_KEY="$secret_key"
            export AWS_DEFAULT_REGION="$aws_region"
            
            echo "=== start invalidation ==="
            aws cloudfront create-invalidation --distribution-id ${cloud_front_distribution_id} --paths "/*" || \
            aws cloudfront create-invalidation --distribution-id ${cloud_front_distribution_id} --paths "/*"
          '''
        }
      }
    }

    stage('cdn77_purge') {
      when { 
        anyOf { branch 'develop'; 
                branch 'master' }
      }
      environment {
        cdn77_distribution_id = "${cdn77_distribution_id}"
      }
      steps {
        withCredentials([
                usernamePassword(credentialsId: 'aws_build_robot', 
                passwordVariable: 'secret_key', 
                usernameVariable: 'access_key'),
                string(credentialsId: 'universal-cdn-purge-url', variable: 'cdn_purge_queue_url')]) {
          sh '''
            export AWS_ACCESS_KEY_ID="$access_key"
            export AWS_SECRET_ACCESS_KEY="$secret_key"
            export AWS_DEFAULT_REGION="$(echo "$cdn_purge_queue_url" | cut -d. -f2)"

            echo "=== start cdn77 purge ==="
            aws sqs send-message \
              --queue-url "$cdn_purge_queue_url" \
              --message-body "{\\"version\\":1,\\"event\\":\\"${BRANCH_NAME}.deploy.purge_all\\",\\"cdn_id\\":${cdn77_distribution_id},\\"purge_all\\":true}"
          '''
        }
      }
    }
  }
  post {
    always {
      script {
        if (env.BRANCH_NAME == 'master') {
          build job: 'monitor.24x7.start.stop', 
            parameters: [string(name: 'monitor_id', value: "${MONITOR_ID}"), 
            string(name: 'action', value: 'activate')]
        }
      }
    }
  }
}
